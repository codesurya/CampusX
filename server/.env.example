# CampusX Server Environment Variables
PORT=5000
NODE_ENV=production

# MongoDB Atlas Connection URI
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/campusx?retryWrites=true&w=majority

# JWT Authentication Secret Key
JWT_SECRET=your_secure_random_jwt_secret_key_minimum_32_chars

# Frontend Client URL for CORS
# In production on Render, set this to your Vercel deployment URL:
CLIENT_URL=https://<your-campusx-app>.vercel.app
